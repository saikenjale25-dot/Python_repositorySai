      "source": [
        "#Dictionary storing item name and quantity\n",
        "inventory = {\n",
        "    \"Apples\": 50,\n",
        "    \"Bananas\": 30\n",
        "}\n",
        "\n",
        "#Adding new stock\n",
        "inventory[\"Oranges\"] = 40\n",
        "\n",
        "print(\"Updated Inventory:\")\n",
        "for item, qty in inventory.items():\n",
        "    print(item, \":\",qty)"
      ]
    }
  ]
