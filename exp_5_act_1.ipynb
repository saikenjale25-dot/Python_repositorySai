      "source": [
        "#Dictionary storing book names and prices\n",
        "books = {\n",
        "    \"Maths\":250,\n",
        "    \"Science\":300,\n",
        "    \"English\":200\n",
        "}\n",
        "\n",
        "#Updating price of a book\n",
        "books[\"Science\"] = 350\n",
        "\n",
        "print(\"Updated Book Prices:\")\n",
        "for book, price in books.items():\n",
        "    print(book, \":\",price)"
      ]
    }
  ]
