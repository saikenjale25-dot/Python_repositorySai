      "source": [
        "#Roll number of students in two classes\n",
        "classA = {1, 2, 3, 4, 5}\n",
        "classB = {4, 5, 6, 7, 8}\n",
        "\n",
        "# Finding common students\n",
        "common_students = classA.intersection(classB)\n",
        "\n",
        "print(\"students present in both classes:\", common_students)"
      ]
    }
