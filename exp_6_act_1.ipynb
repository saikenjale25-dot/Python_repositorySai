      "source": [
        "f = open(\"expenses.txt\", \"w\")\n",
        "expenses = [100,200,150,250,300]\n",
        "\n",
        "for e in expenses:\n",
        "  f.write(str(e)+\"\\n\")\n",
        "f.close()\n",
        "\n",
        "f=open(\"expenses.txt\",\"r\")\n",
        "total = 0\n",
        "for line in f:\n",
        "  total += int(line)\n",
        "f.close()\n",
        "\n",
        "print(\"total monthly expense:\", total)"
      ]
    }
  ]
}